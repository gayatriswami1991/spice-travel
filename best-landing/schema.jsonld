  {
   "@type": "FAQPage",
   "@id": "https://spicetravel.co.ke/best-travel-agent-nairobi/#faq",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "What does a corporate travel agent do?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "A corporate travel agent books and manages business travel for your company: flights, hotels, transfers, visas and trip changes, with one point of contact, negotiated rates and itemised invoicing."
     }
    },
    {
     "@type": "Question",
     "name": "Why choose Spice Travel as your travel agent in Nairobi?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "We are IATA certified, have served Nairobi since 1994, are rated 5 on Google and have managed groups of more than 100 travellers. One team handles flights, hotels, transfers, visas and insurance."
     }
    },
    {
     "@type": "Question",
     "name": "What group sizes do you handle?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "From a single business traveller to groups of 100+. Our largest coordinated event had more than 100 attendees, including group flights, hotel blocks and transfers."
     }
    },
    {
     "@type": "Question",
     "name": "Do you offer team building and corporate retreat packages in Kenya?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. We organise team building and corporate retreats at safari lodges, bush resorts and coastal hotels, including transport, meals and activities. See the retreat packages above for starting prices."
     }
    },
    {
     "@type": "Question",
     "name": "Can you book flights on any airline?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. We book domestic and international flights through Amadeus and Travelport systems, including group and last-minute bookings."
     }
    },
    {
     "@type": "Question",
     "name": "How fast will I get a quote?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "A consultant calls you back and sends a written quote the same day on working days. Office hours are Mon\u2013Fri 8:30am\u20135:30pm and Sat 8:30am\u20131pm."
     }
    },
    {
     "@type": "Question",
     "name": "Can you invoice our company?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. We prepare itemised corporate invoices. If your team travels often, ask about an ongoing business travel arrangement during the call."
     }
    },
    {
     "@type": "Question",
     "name": "Do you handle conferences, NGOs and international delegations?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes, inbound and outbound: group flights, visa assistance, hotel blocks, ground transfers and arrival logistics for conference delegates and project teams."
     }
    },
    {
     "@type": "Question",
     "name": "Do you also sell holiday and safari packages?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. We offer Kenya safari packages, beach holidays and international trips for individuals, families and groups. Prices on this page are indicative starting prices per person sharing."
     }
    },
    {
     "@type": "Question",
     "name": "Can you arrange car hire, transfers and travel insurance?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. We add airport transfers, car hire and travel insurance to the same quote, so everything is booked and invoiced together."
     }
    }
   ]
